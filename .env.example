# Create a Sanity project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=replace-with-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
# Optional only if you later need server-side draft preview:
SANITY_API_READ_TOKEN=
# Site URL, e.g. https://birodjia.com
NEXT_PUBLIC_SITE_URL=https://birodjia.com
